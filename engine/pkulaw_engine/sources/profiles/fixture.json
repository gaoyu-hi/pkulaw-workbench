{
  "profileId": "fixture",
  "version": "fixture-2026-11-01",
  "description": "Local deterministic HTML fixture profile",
  "detection": {
    "any": [
      "[data-pkulaw-profile=\"fixture\"]",
      "#fixture-login",
      "#pkulaw-search-submit",
      "#pkulaw-results"
    ]
  },
  "requiredControls": [
    "searchInput",
    "searchSubmit"
  ],
  "diagnosticControls": [
    "searchInput",
    "searchSubmit"
  ],
  "selectors": {
    "searchPath": "pkulaw/",
    "searchInput": "#txtSearch",
    "searchSubmit": "#pkulaw-search-submit",
    "exactMode": "",
    "titleSearchType": "",
    "libraryRoot": "#subLibraries",
    "libraryAttribute": "library",
    "pageSize": "select[name=\"pageSize\"]",
    "pageSizeTrigger": ".articleSelect",
    "pageSizeMenu": "#recordPage",
    "pageSizeItem": "#recordPage dd",
    "pageSizeHidden": "input[name=\"Pager.PageSize\"], select[name=\"pageSize\"]",
    "filters": {
      "year": "select[name=\"year\"]",
      "province": "select[name=\"province\"]",
      "timeliness": "select[name=\"timeliness\"]"
    },
    "filterSubmit": "#pkulaw-filter-submit",
    "groupUngroup": "#right_form input[name=\"group\"][value=\"2\"]",
    "resultsRoot": "#pkulaw-results",
    "resultLink": ".col .t h4 a[href*=\".html\"]",
    "resultNumber": "[name=\"sortNum\"]",
    "resultCount": ".filtrater-box .total strong",
    "pagination": "nav.pagination, ul.pagination",
    "batchButton": ".list-tool-wrap a.down-all",
    "batchDialog": "[name=\"bathDownloadContainer\"], .layer-down-content",
    "batchFormat": "input[name=\"batchDownload\"]",
    "batchConfirm": "#batchDownload",
    "batchCatalogFormatInput": "#catalog-format",
    "batchCheckbox": "input[type=\"checkbox\"][name=\"recordList\"]",
    "batchSort": "[name=\"sortNum\"]",
    "detailTitle": ".fulltext-wrap .title",
    "detailBody": ".fulltext-wrap .content",
    "detailFields": ".fields li",
    "downloadWord": "li.singleDownload[filetype=\"fullWord\"]",
    "captcha": ".drag_text, #captcha-overlay",
    "login": "#fixture-login",
    "emptyMarkers": [
      "抱歉，未找到相关结果",
      "没有找到相关结果",
      "未找到符合条件的法规",
      "暂无相关结果"
    ]
  },
  "fallbacks": {
    "searchInput": [
      {
        "strategy": "css",
        "value": "input.search-input"
      },
      {
        "strategy": "attribute",
        "attribute": "placeholder",
        "contains": "检索",
        "tags": "input[type=\"text\"],input[type=\"search\"]"
      },
      {
        "strategy": "form-child",
        "root": "form",
        "value": "input[type=\"text\"],input[type=\"search\"]"
      }
    ],
    "searchSubmit": [
      {
        "strategy": "css",
        "value": ".fallback-submit"
      },
      {
        "strategy": "text",
        "text": "检索",
        "tags": "button,a,[role=\"button\"]"
      },
      {
        "strategy": "form-child",
        "root": "form",
        "value": "button[type=\"submit\"],input[type=\"submit\"]"
      }
    ]
  }
}
